# Database — Neon serverless Postgres (free tier at neon.tech)
# Get this from: Neon dashboard → your project → Connection Details → copy "Connection string"
# Format: postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth v5
# Generate a random secret with: openssl rand -base64 48
AUTH_SECRET="replace-with-your-random-secret"
AUTH_URL="http://localhost:3000"

# Server-only NVIDIA model on Nebius Token Factory
NEBIUS_API_KEY=""
NEBIUS_MODEL="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B"
# Shared company allowance, plus 5 requests per user per minute per feature
AI_DAILY_REQUEST_LIMIT="100"

# First company account (never use a shared/default password)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Accountant"
COMPANY_NAME="Demo company"

# Optional private database backup destination (never commit backups)
# BACKUP_PATH="/private/path/taxtech.dump"
